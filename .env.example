# Copiar a .env (que NO se versiona) y completar los valores marcados como CAMBIAR.
# Solo para desarrollo local. No usar credenciales reales ni reutilizar contraseñas personales.

# --- PostgreSQL ---
POSTGRES_DB=ghostwall
POSTGRES_USER=ghostwall
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PORT=6379

# --- Keycloak (proveedor OIDC local, ADR 0008) ---
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIAR

# --- Mailpit (captura de correos en desarrollo) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Aplicaciones ---
API_PORT=3001
ML_PORT=8001
