# Finales de línea LF en el repositorio, independientemente de core.autocrlf de cada máquina
* text=auto eol=lf

# Scripts de Windows conservan CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.woff2 binary
