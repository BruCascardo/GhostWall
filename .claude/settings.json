{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run verify *)",
      "Bash(npm run lint *)",
      "Bash(npm run format:check *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run build *)",
      "Bash(npm run test:unit *)",
      "Bash(npm run test:integration *)",
      "Bash(npm run test:e2e *)",
      "Bash(npm run ml:test *)",
      "Bash(npm run ml:lint *)",
      "Bash(npm run ml:typecheck *)",
      "Bash(npm run ml:format:check *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(npm run verify *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run format:check *)",
      "PowerShell(npm run typecheck *)",
      "PowerShell(npm run build *)",
      "PowerShell(npm run test:unit *)",
      "PowerShell(npm run test:integration *)",
      "PowerShell(npm run test:e2e *)",
      "PowerShell(npm run ml:test *)",
      "PowerShell(npm run ml:lint *)",
      "PowerShell(npm run ml:typecheck *)",
      "PowerShell(npm run ml:format:check *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npm audit fix *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune *)",
      "Bash(docker compose * down -v *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npm update *)",
      "PowerShell(npm audit fix *)",
      "PowerShell(uv add *)",
      "PowerShell(uv remove *)",
      "PowerShell(docker volume rm *)",
      "PowerShell(docker system prune *)",
      "PowerShell(docker compose * down -v *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git pull *)",
      "Bash(git am *)",
      "Bash(git revert *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh workflow run *)",
      "Bash(npm publish *)",
      "Bash(docker push *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git cherry-pick *)",
      "PowerShell(git pull *)",
      "PowerShell(git am *)",
      "PowerShell(git revert *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh release *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(npm publish *)",
      "PowerShell(docker push *)",
      "Read(./.env)",
      "Edit(./docs/1er Entrega/**)",
      "Edit(./docs/2da Entrega/**)",
      "Edit(./docs/3er Entrega/**)",
      "Edit(./docs/Artefactos/**)",
      "Edit(./docs/Cosas Generales/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/bloquear-operaciones-git.mjs"],
            "timeout": 10,
            "statusMessage": "Verificando que el comando no publique ni reescriba Git"
          }
        ]
      }
    ]
  }
}
